{
  "name": "example",
  "private": true,
  "version": "0.0.0",
  "main": "bundle/index.js",
  "scripts": {
    "dev": "node scripts/watch.mjs",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "tsc -b && webpack",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "preview": "qode --inspect ./bundle/index.js",
    "deploy": "npm run build && nodegui-packer --pack ./bundle"
  },
  "dependencies": {
    "@cervisebas/nodegui-plugin-animation": "workspace:*",
    "@cervisebas/react-nodegui": "workspace:*",
    "@cervisebas/react-nodegui-plugin-animation": "workspace:*",
    "@nodegui/nodegui": "^0.74.0",
    "@types/color": "^4.2.0",
    "color": "^5.0.3",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@cervisebas/nodegui-packer": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.0.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.10",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "execa": "^9.5.2",
    "file-loader": "^6.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.3.0",
    "jiti": "^2.6.1",
    "node-loader": "^2.1.0",
    "prettier": "^3.8.1",
    "tslib": "^2.8.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.56.1",
