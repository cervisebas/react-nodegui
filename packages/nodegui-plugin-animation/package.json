{
    "name": "@cervisebas/nodegui-plugin-animation",
    "version": "1.0.0",
    "main": "dist/index.js",
    "typings": "dist/index.d.ts",
    "scripts": {
        "build": "tsc && npm run build:addon",
        "postinstall": "npm run build:addon",
        "build:addon": "cross-env CMAKE_BUILD_PARALLEL_LEVEL=8 cmake-js compile",
        "dev": "tsc && qode dist/demo.js",
        "test": "qode ./node_modules/.bin/jest",
        "lint:cpp": "clang-format -i --glob=src/cpp/**/*.[h,c,cpp]*",
        "lint:ts": "tsc --noEmit && eslint './src/**/*.{ts,tsx,js,jsx}' --fix"
    },
    "author": "Cervisebas",
    "license": "MIT",
    "peerDependencies": {
        "@nodegui/nodegui": "^0.71.0"
    },
    "files": [
        "config",
        "dist",
        "src",
        ".clang-format",
        "CMakeLists.txt",
        "package.json",
        "README.md"
    ],
    "dependencies": {
        "bluebird": "^3.7.2",
        "cmake-js": "^7.4.0",
        "cross-env": "^10.1.0",
        "node-addon-api": "^8.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@nodegui/nodegui": "^0.73.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.0.6",
        "@typescript-eslint/eslint-plugin": "~8.52.0",
        "@typescript-eslint/parser": "~8.52.0",
        "clang-format": "~1.8.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "~10.1.8",
        "eslint-plugin-prettier": "~5.5.4",
        "globals": "^17.0.0",
        "husky": "^9.1.7",
        "jest": "~30.2.0",
        "jiti": "^2.6.1",
        "prettier": "^3.7.4",
        "ts-jest": "~29.4.6",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.52.0"
    },
    "husky": {
        "hooks": {
            "pre-push": "npm run lint:ts && npm run lint:cpp && npm run test"
        }
    }
}
